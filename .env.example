# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# Node Environment
NODE_ENV="development"
PORT=3000

# Database (Development - PostgreSQL)
DATABASE_URL="postgresql://binventory:binventory_local@localhost:5433/binventory?schema=public"

# Database (Production - Supabase)
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].pooler.supabase.com:6543/postgres?schema=public"
# SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
# SUPABASE_ANON_KEY="your-supabase-anon-key"

# Authentication
JWT_SECRET="your-secret-key-here"
JWT_EXPIRES_IN="24h"

# S3 Storage (Development - LocalStack)
S3_ENDPOINT="http://localhost:4566"
S3_BUCKET_NAME="binventory-uploads"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="binventory"
AWS_SECRET_ACCESS_KEY="binventory_local"

# S3 Storage (Production - Cloudflare R2)
# S3_ENDPOINT="https://[YOUR-ACCOUNT-ID].r2.cloudflarestorage.com"
# S3_BUCKET_NAME="binventory-uploads"
# AWS_REGION="auto"
# AWS_ACCESS_KEY_ID="your-r2-access-key"
# AWS_SECRET_ACCESS_KEY="your-r2-secret-key"

# Authentication (NextAuth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_ID=your-github-id
GITHUB_SECRET=your-github-secret 